# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Secrets
USER_JWT_SECRET=replace_with_a_long_random_secret_string

# Database Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/secondbrain?retryWrites=true&w=majority

# CORS Configuration (Comma-separated custom origins)
ALLOWED_ORIGINS=https://second-brain-wine-sigma.vercel.app,http://localhost:5173

# AI & External APIs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
SHARABLE_LINK_HOST=https://second-brain-wine-sigma.vercel.app
